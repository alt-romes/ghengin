signature Ghengin.Core.Renderer.Command where

import Data.Word (Word32)

import Ghengin.Core.Prelude
import Ghengin.Core.Log

import Ghengin.Core.Renderer.Pipeline
import Ghengin.Core.Renderer.Buffer
import Ghengin.Core.Renderer.DescriptorSet

import qualified Data.Functor.Linear as Data
import qualified Control.Functor.Linear as Linear
import qualified Control.Monad.IO.Class.Linear as Linear

type Command m = CommandM m ()
type RenderCmd m = RenderCmdM m ()

type role CommandM representational nominal
type CommandM :: (Type -> Type) -> Type -> Type
data CommandM m a

type role RenderCmdM representational nominal
type RenderCmdM :: (Type -> Type) -> Type -> Type
data RenderCmdM m a

-- Abstract backend-provided types.
data CommandBuffer
data Viewport
data Rect2D

instance Linear.Functor m     => Linear.Functor (CommandM m)
instance Data.Functor m       => Data.Functor (CommandM m)
instance Linear.Applicative m => Linear.Applicative (CommandM m)
instance Data.Applicative m   => Data.Applicative (CommandM m)
instance Linear.Monad m       => Linear.Monad (CommandM m)
instance Linear.MonadIO m     => Linear.MonadIO (CommandM m)
instance HasLogger m          => HasLogger (CommandM m)
instance Linear.MonadTrans CommandM

instance Linear.Functor m     => Linear.Functor (RenderCmdM m)
instance Data.Functor m       => Data.Functor (RenderCmdM m)
instance Linear.Applicative m => Linear.Applicative (RenderCmdM m)
instance Data.Applicative m   => Data.Applicative (RenderCmdM m)
instance Linear.Monad m       => Linear.Monad (RenderCmdM m)
instance Linear.MonadIO m     => Linear.MonadIO (RenderCmdM m)
instance HasLogger m          => HasLogger (RenderCmdM m)
instance Linear.MonadTrans RenderCmdM

-- Recording
recordCommand :: Linear.MonadIO m => CommandBuffer ⊸ CommandM m a ⊸ m (a, CommandBuffer)
recordCommandOneShot :: Linear.MonadIO m => CommandBuffer ⊸ CommandM m a ⊸ m (CommandBuffer, a)

-- Pipeline Binding
bindGraphicsPipeline :: Linear.MonadIO m => RendererPipeline Graphics ⊸ RenderCmdM m (RendererPipeline Graphics)
bindGraphicsDescriptorSet :: Linear.MonadIO m
                          => RendererPipeline Graphics
                          ⊸ Word32 -- ^ Set index at which to bind the descriptor set
                          -> DescriptorSet ⊸ RenderCmdM m (DescriptorSet, RendererPipeline Graphics)

-- Dynamic State
setViewport :: Linear.MonadIO m => Viewport -> RenderCmd m
setScissor :: Linear.MonadIO m => Rect2D -> RenderCmd m

-- Drawing Commands
draw :: Linear.MonadIO m => Word32 -> RenderCmd m
drawIndexed :: Linear.MonadIO m => Word32 -> RenderCmd m
drawVertexBuffer :: Linear.MonadIO m => VertexBuffer ⊸ RenderCmdM m VertexBuffer
drawVertexBufferIndexed :: Linear.MonadIO m => VertexBuffer ⊸ Index32Buffer ⊸ RenderCmdM m (VertexBuffer, Index32Buffer)
